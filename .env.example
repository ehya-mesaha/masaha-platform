# Public site URL used in StreamPay success/failure redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# StreamPay server-only settings. Never prefix these with NEXT_PUBLIC_.
# STREAMPAY_X_API_KEY is the complete Base64 x-api-key value generated from
# api-key:api-secret. Do not paste either secret into source control or chat.
STREAMPAY_X_API_KEY=replace_with_new_base64_x_api_key
STREAMPAY_WEBHOOK_SECRET=replace_with_new_webhook_secret
STREAMPAY_BRANCH_ID=replace_with_branch_id_if_required

# Keep true while using StreamPay's sandbox organization. Change to false only
# after the full sandbox checklist and a controlled live test have passed.
STREAMPAY_EXPECTED_SANDBOX=true

# A long random value used only to protect the scheduled reconciliation route.
STREAMPAY_RECONCILE_SECRET=replace_with_long_random_reconciliation_secret
STREAMPAY_WEBHOOK_TOLERANCE_SECONDS=600
