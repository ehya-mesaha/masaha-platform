generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  SELLER
  BUYER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_APPROVAL
}

enum SpaceStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  INACTIVE
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  PAYMENT_FAILED
  PAYMENT_EXPIRED
  CANCELLED_BY_BUYER
  CANCELLED_BY_SELLER
  COMPLETED
}

enum PaymentOrderStatus {
  PENDING
  CHECKOUT_CREATED
  PAID
  FAILED
  EXPIRED
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentRefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED
}

enum CouponRedemptionStatus {
  RESERVED
  CONFIRMED
  RELEASED
}

enum StreamWebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
}

enum SpaceNeedStatus {
  NEW
  IN_REVIEW
  MATCHED
  CLOSED
}

enum ConversationType {
  SPACE
  ADMIN_SUPPORT
}

enum CancellationPolicy {
  FLEXIBLE
  MODERATE
  STRICT
}

enum DocumentType {
  NATIONAL_ID
  COMMERCIAL_REGISTER
  TITLE_DEED
  POWER_OF_ATTORNEY
}

enum OccupancyStatus {
  PLANNED
  CONFIRMED
}

enum ClosureStatus {
  ACTIVE
  CANCELLED
}

enum ServicePricingType {
  PER_BOOKING
  PER_PERSON
  PER_HOUR
  PER_ITEM
  PER_TEN_PAGES
  PRINT_MATRIX
  CUSTOM
}

enum PartnerServiceRequestStatus {
  DRAFT
  UNDER_REVIEW
  QUOTED
  ACCEPTED
  REJECTED
  COMPLETED
}

enum SellerApplicationStatus {
  DATA_REVIEW
  CONTRACT_SENT
  APPROVED
  EXPIRED
  REJECTED
  CHANGES_REQUESTED
}

enum ContactMessageType {
  INQUIRY
  SUGGESTION
  COMPLAINT
}

enum OrganizationRole {
  OWNER
  MANAGER
  STAFF
}

model User {
  id              String     @id @default(cuid())
  name            String
  email           String     @unique
  phone           String?
  avatarUrl       String?
  password        String
  role            Role       @default(BUYER)
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  spaces    Space[]
  bookings  Booking[]
  documents UserDocument[]

  buyerConversations       Conversation[]            @relation("BuyerConversations")
  sellerConversations      Conversation[]            @relation("SellerConversations")
  adminConversations       Conversation[]            @relation("AdminConversations")
  sentMessages             ConversationMessage[]
  reviews                  SpaceReview[]
  spaceNeedRequests        SpaceNeedRequest[]
  favorites                Favorite[]
  notifications            Notification[]
  savedSearches            SavedSearch[]
  sellerApplication        SellerApplication?
  organizationMemberships  OrganizationMember[]
  contactMessages          ContactMessage[]
  partnerServiceRequests   PartnerServiceRequest[]
  adminAuditLogs           AdminAuditLog[]
  paymentOrders            PaymentOrder[]
  paymentProviderCustomers PaymentProviderCustomer[]
  passwordResetTokens      PasswordResetToken[]
  couponRedemptions        CouponRedemption[]
  createdCoupons           Coupon[]                  @relation("CouponCreatedBy")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

model UserDocument {
  id         String       @id @default(cuid())
  type       DocumentType
  fileUrl    String
  uploadedAt DateTime     @default(now())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SpaceType {
  id           String             @id @default(cuid())
  name         String             @unique
  spaces       Space[]
  needRequests SpaceNeedRequest[]
}

model City {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Amenity {
  id       String         @id @default(cuid())
  name     String         @unique
  icon     String?
  category String?
  spaces   SpaceAmenity[]
}

model Space {
  id                       String      @id @default(cuid())
  name                     String
  description              String?
  city                     String
  district                 String?
  address                  String?
  capacity                 Int?
  price                    Float
  pricePeriod              String      @default("hour")
  publicRef                String?     @unique
  refSeq                   Int         @unique @default(autoincrement())
  advertisingLicenseNumber String?
  identicalUnitsCount      Int         @default(1)
  status                   SpaceStatus @default(DRAFT)
  adminNotes               String?
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  latitude       Float?
  longitude      Float?
  streetName     String?
  buildingNumber String?
  postalCode     String?
  landmarks      String?

  minBookingHours       Int?
  maxAdvanceBookingDays Int?
  cancellationPolicy    CancellationPolicy @default(FLEXIBLE)
  ownerTermsAcceptedAt  DateTime?
  ownerTermsVersion     String?

  typeId         String
  type           SpaceType           @relation(fields: [typeId], references: [id])
  sellerId       String
  seller         User                @relation(fields: [sellerId], references: [id])
  organizationId String?
  organization   SchoolOrganization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  images             SpaceImage[]
  amenities          SpaceAmenity[]
  bookings           Booking[]
  workingHours       SpaceWorkingHours[]
  services           SpaceService[]
  units              SpaceUnit[]
  pricingTiers       PricingTier[]
  privateOccupancies PrivateOccupancy[]
  temporaryClosures  TemporaryClosure[]
  serviceConfigs     SpaceServiceConfig[]
  favorites          Favorite[]
  rules              SpaceRule[]
  conversations      Conversation[]
  reviews            SpaceReview[]

  @@index([status, createdAt])
  @@index([status, city])
  @@index([status, typeId])
  @@index([status, price])
}

model SchoolOrganization {
  id         String   @id @default(cuid())
  name       String
  branchName String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  members OrganizationMember[]
  spaces  Space[]
}

model OrganizationMember {
  id             String             @id @default(cuid())
  role           OrganizationRole   @default(STAFF)
  userId         String
  organizationId String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   SchoolOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime           @default(now())

  @@unique([userId, organizationId])
  @@index([organizationId, role])
}

model SpaceImage {
  id      String @id @default(cuid())
  url     String
  order   Int    @default(0)
  spaceId String
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([spaceId, order])
}

model SpaceAmenity {
  spaceId   String
  amenityId String
  space     Space   @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  amenity   Amenity @relation(fields: [amenityId], references: [id])

  @@id([spaceId, amenityId])
}

model SpaceWorkingHours {
  id        String  @id @default(cuid())
  dayOfWeek Int
  isOpen    Boolean @default(true)
  openTime  String  @default("08:00")
  closeTime String  @default("22:00")
  spaceId   String
  space     Space   @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, dayOfWeek])
}

model SpaceUnit {
  id        String   @id @default(cuid())
  label     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  bookings           Booking[]
  privateOccupancies PrivateOccupancy[]
  temporaryClosures  TemporaryClosure[]

  @@unique([spaceId, label])
  @@index([spaceId, isActive])
}

model PricingTier {
  id              String @id @default(cuid())
  minHours        Int
  discountPercent Float
  spaceId         String
  space           Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, minHours])
}

model PrivateOccupancy {
  id        String          @id @default(cuid())
  title     String
  startTime DateTime
  endTime   DateTime
  status    OccupancyStatus @default(CONFIRMED)
  /// Ties the occurrences of one repeating programme together. Null for a one-off.
  seriesId  String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  spaceId   String
  space     Space           @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  unitId    String?
  unit      SpaceUnit?      @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([spaceId, startTime, endTime])
  @@index([unitId, startTime, endTime])
  @@index([seriesId])
}

model TemporaryClosure {
  id        String        @id @default(cuid())
  title     String
  startTime DateTime
  endTime   DateTime
  status    ClosureStatus @default(ACTIVE)
  /// Ties the occurrences of one repeating closure together. Null for a one-off.
  seriesId  String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  spaceId   String
  space     Space         @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  unitId    String?
  unit      SpaceUnit?    @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([spaceId, startTime, endTime])
  @@index([seriesId])
  @@index([unitId, startTime, endTime])
}

model SpaceService {
  id          String  @id @default(cuid())
  name        String
  description String?
  price       Float
  pricingType String  @default("PER_BOOKING")
  spaceId     String
  space       Space   @relation(fields: [spaceId], references: [id], onDelete: Cascade)
}

model ServiceCatalog {
  id            String             @id @default(cuid())
  name          String             @unique
  description   String
  category      String
  pricingType   ServicePricingType
  defaultPrice  Float?
  defaultConfig Json?
  isActive      Boolean            @default(true)
  sortOrder     Int                @default(0)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  spaceConfigs SpaceServiceConfig[]
}

model SpaceServiceConfig {
  id        String         @id @default(cuid())
  isEnabled Boolean        @default(false)
  price     Float?
  details   String?
  config    Json?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  spaceId   String
  space     Space          @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  catalogId String
  catalog   ServiceCatalog @relation(fields: [catalogId], references: [id])

  bookingServices BookingService[]

  @@unique([spaceId, catalogId])
  @@index([spaceId, isEnabled])
}

model SpaceRule {
  id        String  @id @default(cuid())
  rule      String
  isDefault Boolean @default(false)
  spaceId   String
  space     Space   @relation(fields: [spaceId], references: [id], onDelete: Cascade)
}

model Booking {
  id                String        @id @default(cuid())
  date              DateTime
  startTime         DateTime
  endTime           DateTime
  persons           Int?
  notes             String?
  requesterIdNumber String?
  status            BookingStatus @default(CONFIRMED)
  sellerNote        String?
  totalHours        Float         @default(0)
  basePrice         Float         @default(0)
  discountAmount    Float         @default(0)
  couponCode        String?
  couponDiscount    Float         @default(0)
  servicesTotal     Float         @default(0)
  grandTotal        Float         @default(0)
  cancelledAt       DateTime?
  cancelledBy       String?
  refundAmount      Float?
  termsAcceptedAt   DateTime?
  termsVersion      String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  spaceId        String
  space          Space           @relation(fields: [spaceId], references: [id])
  buyerId        String
  buyer          User            @relation(fields: [buyerId], references: [id])
  unitId         String
  unit           SpaceUnit       @relation(fields: [unitId], references: [id])
  programId      String?
  program        BookingProgram? @relation(fields: [programId], references: [id], onDelete: SetNull)
  paymentOrderId String?
  paymentOrder   PaymentOrder?   @relation(fields: [paymentOrderId], references: [id], onDelete: SetNull)

  review        SpaceReview?
  services      BookingService[]
  paymentRefund PaymentRefund?

  @@index([unitId, startTime, endTime, status])
  @@index([buyerId, createdAt])
  @@index([programId])
  @@index([paymentOrderId])
}

model BookingService {
  id        String              @id @default(cuid())
  name      String
  quantity  Int                 @default(1)
  unitPrice Float
  lineTotal Float
  bookingId String
  booking   Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  configId  String?
  config    SpaceServiceConfig? @relation(fields: [configId], references: [id], onDelete: SetNull)

  @@index([bookingId])
}

model BookingProgram {
  id              String   @id @default(cuid())
  startDate       DateTime
  endDate         DateTime
  weekdays        Int[]
  sessionStart    String
  sessionEnd      String
  sessionCount    Int
  totalHours      Float
  discountPercent Float    @default(5)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  bookings Booking[]
}

model PaymentOrder {
  id                  String             @id @default(cuid())
  checkoutKey         String             @unique
  checkoutToken       String             @unique @default(uuid())
  status              PaymentOrderStatus @default(PENDING)
  currency            String             @default("SAR")
  amountHalalas       Int
  refundedHalalas     Int                @default(0)
  expiresAt           DateTime
  paidAt              DateTime?
  failedAt            DateTime?
  streamConsumerId    String?
  streamProductId     String?
  streamPaymentLinkId String?            @unique
  streamInvoiceId     String?            @unique
  streamPaymentId     String?            @unique
  checkoutUrl         String?
  lastError           String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  buyerId             String
  buyer               User               @relation(fields: [buyerId], references: [id], onDelete: Restrict)

  bookings         Booking[]
  refunds          PaymentRefund[]
  webhookEvents    StreamWebhookEvent[]
  couponRedemption CouponRedemption?

  @@index([buyerId, createdAt])
  @@index([status, expiresAt])
}

model PaymentProviderCustomer {
  id                 String   @id @default(cuid())
  provider           String   @default("STREAMPAY")
  environment        String
  providerCustomerId String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, environment, userId])
  @@unique([provider, environment, providerCustomerId])
}

model PaymentRefund {
  id               String              @id @default(cuid())
  amountHalalas    Int
  status           PaymentRefundStatus @default(PENDING)
  reason           String
  note             String?
  providerRefundId String?             @unique
  lastError        String?
  requestedAt      DateTime            @default(now())
  processedAt      DateTime?
  updatedAt        DateTime            @updatedAt
  paymentOrderId   String
  paymentOrder     PaymentOrder        @relation(fields: [paymentOrderId], references: [id], onDelete: Restrict)
  bookingId        String?             @unique
  booking          Booking?            @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([paymentOrderId, requestedAt])
  @@index([status, requestedAt])
}

model StreamWebhookEvent {
  id             String              @id @default(cuid())
  payloadHash    String              @unique
  eventType      String
  entityType     String?
  entityId       String?
  providerTime   DateTime?
  status         StreamWebhookStatus @default(RECEIVED)
  lastError      String?
  receivedAt     DateTime            @default(now())
  processedAt    DateTime?
  paymentOrderId String?
  paymentOrder   PaymentOrder?       @relation(fields: [paymentOrderId], references: [id], onDelete: SetNull)

  @@index([eventType, receivedAt])
  @@index([status, receivedAt])
  @@index([paymentOrderId])
}

model Favorite {
  userId    String
  spaceId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@id([userId, spaceId])
  @@index([spaceId])
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  href      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

model SavedSearch {
  id        String   @id @default(cuid())
  name      String
  criteria  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

model PartnerService {
  id              String             @id @default(cuid())
  name            String             @unique
  description     String
  pricingType     ServicePricingType
  indicativePrice Float?
  isActive        Boolean            @default(true)
  sortOrder       Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  requestItems PartnerServiceRequestItem[]
}

model PartnerServiceRequest {
  id             String                      @id @default(cuid())
  publicRef      String                      @unique
  status         PartnerServiceRequestStatus @default(DRAFT)
  notes          String?
  adminNotes     String?
  estimatedTotal Float                       @default(0)
  quotedTotal    Float?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
  buyerId        String
  buyer          User                        @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  bookingId      String?

  items PartnerServiceRequestItem[]

  @@index([buyerId, createdAt])
  @@index([status, createdAt])
}

model PartnerServiceRequestItem {
  id             String                @id @default(cuid())
  quantity       Int                   @default(1)
  details        String?
  estimatedPrice Float?
  quotedPrice    Float?
  requestId      String
  request        PartnerServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  serviceId      String
  service        PartnerService        @relation(fields: [serviceId], references: [id])

  @@index([requestId])
}

model SellerApplication {
  id                    String                  @id @default(cuid())
  schoolName            String
  branchName            String?
  commercialRegisterNo  String
  nationalIdNumber      String?
  multipleOwners        Boolean                 @default(false)
  powerOfAttorneyNumber String?
  brokerageContractNo   String?
  contractSentAt        DateTime?
  approvalDeadline      DateTime?
  status                SellerApplicationStatus @default(DATA_REVIEW)
  adminNotes            String?
  consentAcceptedAt     DateTime
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  userId                String                  @unique
  user                  User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([commercialRegisterNo])
}

model ContactMessage {
  id        String             @id @default(cuid())
  type      ContactMessageType
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  isRead    Boolean            @default(false)
  createdAt DateTime           @default(now())
  userId    String?
  user      User?              @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([type, isRead, createdAt])
}

model SpaceNeedRequest {
  id           String          @id @default(cuid())
  spaceType    String
  city         String
  district     String?
  expectedDate String?
  capacity     Int
  budgetMin    Float?
  budgetMax    Float?
  details      String?
  status       SpaceNeedStatus @default(NEW)
  adminNote    String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  buyerId String
  buyer   User       @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  typeId  String?
  type    SpaceType? @relation(fields: [typeId], references: [id], onDelete: SetNull)

  @@index([buyerId, createdAt])
  @@index([status, createdAt])
  @@index([typeId])
  @@index([city])
}

model Conversation {
  id            String           @id @default(cuid())
  type          ConversationType @default(SPACE)
  subject       String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  lastMessageAt DateTime?

  buyerId  String?
  buyer    User?   @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: SetNull)
  sellerId String?
  seller   User?   @relation("SellerConversations", fields: [sellerId], references: [id], onDelete: SetNull)
  adminId  String?
  admin    User?   @relation("AdminConversations", fields: [adminId], references: [id], onDelete: SetNull)
  spaceId  String?
  space    Space?  @relation(fields: [spaceId], references: [id], onDelete: SetNull)

  messages ConversationMessage[]

  @@index([buyerId])
  @@index([sellerId])
  @@index([adminId])
  @@index([spaceId])
  @@index([type])
}

model ConversationMessage {
  id        String   @id @default(cuid())
  content   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model SpaceReview {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  spaceId   String
  space     Space   @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  buyerId   String
  buyer     User    @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([spaceId, isVisible, createdAt])
  @@index([buyerId])
  @@index([rating])
}

model Coupon {
  id                String             @id @default(cuid())
  code              String             @unique
  description       String?
  discountType      CouponDiscountType
  discountValue     Float
  maxDiscountAmount Float?
  minBookingAmount  Float?
  startsAt          DateTime
  endsAt            DateTime
  maxRedemptions    Int?
  maxPerUser        Int?
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  createdById       String?
  createdBy         User?              @relation("CouponCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  redemptions CouponRedemption[]

  @@index([isActive, startsAt, endsAt])
}

model CouponRedemption {
  id              String                 @id @default(cuid())
  status          CouponRedemptionStatus @default(RESERVED)
  discountHalalas Int
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  confirmedAt     DateTime?
  releasedAt      DateTime?

  couponId String
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  paymentOrderId String       @unique
  paymentOrder   PaymentOrder @relation(fields: [paymentOrderId], references: [id], onDelete: Cascade)

  @@index([couponId, status])
  @@index([couponId, userId, status])
}
